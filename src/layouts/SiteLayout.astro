---
import '../styles/global.css';
import { withBase } from '../lib/base.js';
interface Props { title?: string; description?: string; }
const courseTitle = 'IB MSc Corporate Finance';
const { title = courseTitle, description = 'Interactive tools for IB MSc Corporate Finance (BUSI70597).' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title === courseTitle ? title : `${title} · ${courseTitle}`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand">
          <a class="wordmark" href={withBase('npv-irr/')} aria-label="Imperial · NPV and IRR"><img class="site-logo" src={withBase('imperial-logo.svg')} alt="Imperial" width="1548" height="170" /></a>
          <span class="course-title">IB MSc Corporate Finance</span>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer"><span>IB MSc Corporate Finance</span><span>Aditya Polisetty</span></footer>
  </body>
</html>
