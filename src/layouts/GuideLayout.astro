---
import SiteLayout from './SiteLayout.astro';
interface Props { title: string; description?: string; current: string; }
const { title, description } = Astro.props;
---

<SiteLayout title={title} description={description}>
  <main class="guide-main" id="main"><slot /></main>
</SiteLayout>

<style>
  .guide-main { min-width: 0; max-width: 2000px; padding: 0 40px 90px 32px; }
  @media (max-width: 900px) { .guide-main { padding: 0 22px 65px; } }
</style>
